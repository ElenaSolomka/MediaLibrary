@model List<WebApp.Models.Movie>
@{
    ViewData["Title"] = "Управление фильмами";
}

<h2>Управление фильмами</h2>

<a asp-action="CreateMovie" class="btn btn-success mb-3">Создать фильм</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Название</th>
            <th>Год</th>
            <th>Режиссер</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.Year</td>
                <td>@movie.Director</td>
                <td>
                    <a asp-action="EditMovie" asp-route-id="@movie.Id" class="btn btn-sm btn-primary">Редактировать</a>
                    <form asp-action="DeleteMovie" asp-route-id="@movie.Id" method="post" class="d-inline" onsubmit="return confirm('Вы уверены?')">
                        <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Назад в админ-панель</a>
