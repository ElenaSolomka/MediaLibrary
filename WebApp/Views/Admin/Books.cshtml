@model List<WebApp.Models.Book>
@{
    ViewData["Title"] = "Управление книгами";
}

<h2>Управление книгами</h2>

<a asp-action="CreateBook" class="btn btn-success mb-3">Создать книгу</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Название</th>
            <th>Год</th>
            <th>Издательство</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Year</td>
                <td>@book.Publisher</td>
                <td>
                    <a asp-action="EditBook" asp-route-id="@book.Id" class="btn btn-sm btn-primary">Редактировать</a>
                    <form asp-action="DeleteBook" asp-route-id="@book.Id" method="post" class="d-inline" onsubmit="return confirm('Вы уверены?')">
                        <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Назад в админ-панель</a>
