@model List<WebApp.Models.User>
@{
    ViewData["Title"] = "Управление пользователями";
    var currentUserId = User.FindFirst("UserId")?.Value;
}

<h2>Управление пользователями</h2>

<a asp-action="CreateUser" class="btn btn-success mb-3">Создать пользователя</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Логин</th>
            <th>Роль</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.Login</td>
                <td>@user.Role</td>
                <td>
                    @if (currentUserId != user.Id.ToString())
                    {
                        <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Вы уверены?')">
                            <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">Текущий пользователь</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Назад в админ-панель</a>
